---
import Layout from "../layouts/Layout.astro";
import Experience from "../components/Experience.astro";
import ContainerSection from "../components/ContainerSection.astro";
import Projects from "../components/Projects.astro";
import About from "../components/About.astro";
import Hero from "../components/Hero.astro";
import ProjectShot from "../components/ProjectShot.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { PROJECTS } from "../data/projects";
import { t } from "../i18n";
---

<Layout title={t.meta.title} description={t.meta.description}>
  <main>
    <Hero />

    <section class="flex w-full flex-col gap-2 py-10" aria-label={t.sections.showcase}>
      <div class="mx-auto flex w-full max-w-7xl px-10">
        <span class="font-mono text-sm italic text-muted-foreground">// {t.projects.items.graphly.imageAlt}</span>
      </div>
      <ProjectShot
        src={PROJECTS[0].image}
        alt={t.projects.items.graphly.imageAlt}
        aspect={null}
        widths={[640, 1280, 1920, 2560, 2880, 3840]}
        sizes="100vw"
        loading="eager"
        class="border-y border-muted"
      />
    </section>

    <ContainerSection id="proyectos" aria-label={t.sections.projects}>
      <SectionTitle count={PROJECTS.length}>{t.sections.projects}</SectionTitle>
      <Projects />
    </ContainerSection>

    <ContainerSection id="experiencia" aria-label={t.sections.experience}>
      <SectionTitle count={t.experience.length}>{t.sections.experience}</SectionTitle>
      <Experience />
    </ContainerSection>

    <ContainerSection id="sobre-mi" aria-label={t.sections.about}>
      <SectionTitle>{t.sections.about}</SectionTitle>
      <About />
    </ContainerSection>
  </main>
</Layout>
