---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import satoshiMedium from "../assets/fonts/Satoshi-Medium.woff2";
import satoshiBlackItalic from "../assets/fonts/Satoshi-BlackItalic.woff2";
import spaceGroteskBold from "../assets/fonts/SpaceGrotesk-Bold.woff2";
import jetbrainsMonoItalic from "../assets/fonts/JetBrainsMono-Italic.woff2";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { ProjectSlug } from "../data/projects";
import {
  DEFAULT_LOCALE,
  LOCALES,
  getLocale,
  homeUrl,
  ogImageUrl,
  projectUrl,
  useTranslations,
  type Locale,
} from "../i18n";

interface Props {
  title: string;
  description: string;
  /** El proyecto de la ficha, si la pagina lo es. Con el se emparejan los
   *  idiomas y se elige la imagen de Open Graph. */
  slug?: ProjectSlug;
  ogType?: "website" | "article";
}

const { title, description, slug, ogType = "website" } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

/** Esta misma pagina en cada idioma: la pagina dice lo que es y aqui se
 *  construyen sus rutas, sin deducirlas de la URL actual. */
const paths = Object.fromEntries(
  LOCALES.map((alternate) => [alternate, slug ? projectUrl(alternate, slug) : homeUrl(alternate)]),
) as Record<Locale, string>;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageHref = new URL(ogImageUrl(locale, slug), Astro.site);
---

<!doctype html>
<html lang={locale} class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={satoshiMedium} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={satoshiBlackItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={spaceGroteskBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMonoItalic} as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={canonical} />
    {LOCALES.map((alternate) => <link rel="alternate" hreflang={alternate} href={new URL(paths[alternate], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(paths[DEFAULT_LOCALE], Astro.site)} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.hero.name} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="bg-background text-foreground antialiased">
    <Header paths={paths} />
    <slot />
    <Footer />
  </body>
</html>

