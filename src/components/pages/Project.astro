---
import Layout from "../../layouts/Layout.astro";
import ProjectShot from "../ProjectShot.astro";
import TagList from "../TagList.astro";
import SectionTitle from "../SectionTitle.astro";
import { PROJECTS, type Project } from "../../data/projects";
import { SECTIONS, getLocale, homeUrl, projectUrl, useTranslations } from "../../i18n";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { slug, liveUrl, repoUrl, image, tags, shots = [] } = project;

// Circular: del ultimo se vuelve al primero, nunca hay final muerto.
const current = PROJECTS.findIndex((candidate) => candidate.slug === slug);
const next = PROJECTS[(current + 1) % PROJECTS.length];

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const { back, next: nextLabel, stack: stackLabel, shots: shotsTitle, zoom, live, repo, items } = t.projects;
const { title, summary, imageAlt, description, shots: shotText } = items[slug];

if (shots.length !== shotText.length) {
  throw new Error(`[${locale}/${slug}] ${shots.length} capturas pero ${shotText.length} descripciones. Deben coincidir.`);
}

const meta = "font-mono text-xs italic tracking-widest text-muted-foreground";
const linkStyle =
  "-my-1 py-1 transition-colors duration-300 hover:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4";
---

<Layout title={`${title} · ${t.hero.name}`} description={summary} slug={slug} ogType="article">
  <main>
    <section class="mx-auto w-full max-w-7xl px-4 pt-10 pb-16 sm:px-10">
      <a
        class:list={["w-fit leading-4 font-mono text-xs italic text-muted-foreground sm:text-sm", linkStyle]}
        href={homeUrl(locale, SECTIONS[locale].projects)}
      >
        <span aria-hidden="true">// </span>{back}
      </a>

      <h1 class="mt-8 text-balance font-display text-title sm:mt-12">{title}</h1>

      <div class="mt-8 grid gap-y-12 sm:mt-12 md:grid-cols-12 md:gap-x-10">
        {
          description.length > 0 && (
            <div class="flex max-w-prose flex-col gap-y-6 text-muted-foreground md:col-span-7">
              {description.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          )
        }

        <div class="flex flex-col gap-y-6 md:col-span-5">
          <div class="flex flex-col gap-y-2">
            <p class="font-mono text-xs italic text-muted-foreground sm:text-sm">
              <span aria-hidden="true">// </span>{stackLabel}
            </p>

            <TagList tags={tags} class={meta} />
          </div>

          {
            (liveUrl || repoUrl) && (
              <p class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                {liveUrl && (
                  <a class={linkStyle} href={liveUrl} target="_blank" rel="noopener">
                    {live}
                  </a>
                )}
                {repoUrl && (
                  <a class={linkStyle} href={repoUrl} target="_blank" rel="noopener">
                    {repo}
                  </a>
                )}
              </p>
            )
          }
        </div>
      </div>
    </section>

    <section class="flex w-full flex-col gap-2 py-10" aria-label={t.sections.cover}>
      <div class="mx-auto flex w-full max-w-7xl px-4 sm:px-10">
        <span class="font-mono text-xs italic text-muted-foreground sm:text-sm">
          <span aria-hidden="true">// </span>{imageAlt}
        </span>
      </div>

      <ProjectShot
        src={image}
        alt={imageAlt}
        aspect={null}
        widths={[640, 1280, 1920, 2560, 2880]}
        sizes="100vw"
        loading="eager"
        class="border-y border-muted"
      />
    </section>

    {
      shots.length > 0 && (
        <section
          class="mx-auto w-full max-w-7xl px-4 pt-14 pb-20 sm:px-10 sm:pt-20 sm:pb-28"
          aria-labelledby="shots-title"
        >
          <SectionTitle id="shots-title" count={shots.length}>
            {shotsTitle}
          </SectionTitle>

          <ol class="mt-6 divide-y divide-muted">
            {shots.map((shot, position) => (
              <li class="grid gap-y-6 py-10 sm:py-14 md:grid-cols-12 md:gap-x-10">
                <p class="flex gap-x-5 md:col-span-4 items-baseline">
                  <span class:list={["shrink-0 tabular-nums", meta]} aria-hidden="true">
                    {String(position + 1).padStart(2, "0")}
                  </span>
                  <span class="text-balance">{shotText[position]}</span>
                </p>

                <button
                  class="group block w-full cursor-zoom-in focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4 md:col-span-8"
                  type="button"
                  data-shot
                  aria-label={`${zoom}: ${shotText[position]}`}
                >
                  <ProjectShot
                    class="border border-muted transition-colors duration-300 group-hover:border-primary group-focus-visible:border-primary"
                    src={shot}
                    alt={shotText[position]}
                    aspect={null}
                    widths={[640, 1280, 1920, 2560]}
                    sizes="(min-width: 1360px) 800px, (min-width: 768px) 64vw, calc(100vw - 2rem)"
                  />
                </button>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      PROJECTS.length > 1 && (
        <nav aria-labelledby="next-title">
          <div class="mx-auto w-full max-w-7xl px-4 sm:px-10">
            <SectionTitle id="next-title">{nextLabel}</SectionTitle>

            <p class="mt-4 font-display text-3xl leading-none sm:text-4xl lg:text-5xl">
              <a
                class:list={["flex items-end justify-between gap-x-6 text-foreground", linkStyle]}
                href={projectUrl(locale, next.slug)}
              >
                <span class="text-balance">{items[next.slug].title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </p>

            <TagList tags={next.tags} class={`mt-3 ${meta}`} />
          </div>
        </nav>
      )
    }

    <dialog
      class="m-0 h-dvh max-h-none w-screen max-w-none cursor-zoom-out overflow-hidden bg-transparent p-0 backdrop:bg-foreground/30 backdrop:backdrop-blur-xl"
      id="lightbox"
      aria-label={shotsTitle}
    >
      <img class="size-full object-contain" data-lightbox-image alt="" />
    </dialog>
  </main>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
  const triggers = [...document.querySelectorAll<HTMLButtonElement>("[data-shot]")];

  if (dialog && triggers.length > 0) {
    const image = dialog.querySelector<HTMLImageElement>("[data-lightbox-image]")!;

    let opener: HTMLButtonElement | null = null;

    triggers.forEach((trigger) =>
      trigger.addEventListener("click", () => {
        const source = trigger.querySelector("img")!;

        // Reusa el srcset de la miniatura y deja que el navegador escoja
        // un candidato mayor ahora que ocupa todo el ancho.
        image.srcset = source.srcset;
        image.sizes = "100vw";
        image.src = source.src;
        image.alt = source.alt;

        opener = trigger;
        dialog.showModal();
      }),
    );

    // Se cierra igual que se abre: pulsando sobre la imagen.
    // Escape lo cierra de forma nativa y devuelve el foco por su cuenta.
    dialog.addEventListener("click", () => {
      dialog.close();
      opener?.focus();
    });
  }
</script>
