---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  aspect?: string | null;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt,
  widths = [320, 660, 1000, 1320],
  sizes = "(min-width: 1024px) 655px, (min-width: 768px) 48vw, calc(100vw - 4rem)",
  aspect = "aspect-21/9",
  loading = "lazy",
  class: className = "",
} = Astro.props;

const width = Math.max(...widths);
const height = Math.round((width * src.height) / src.width);
---

<div class:list={[aspect, aspect && "overflow-hidden", "bg-muted", className]}>
  <Image
    class:list={["w-full", aspect ? "h-full object-cover object-top" : "h-auto"]}
    src={src}
    alt={alt}
    width={width}
    height={height}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : undefined}
  />
</div>
