---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  widths = [320, 660, 1000, 1320],
  sizes = "(min-width: 1024px) 655px, (min-width: 768px) 48vw, calc(100vw - 7rem)",
  class: className = "",
} = Astro.props;

const width = Math.max(...widths);
const height = Math.round((width * src.height) / src.width);
---

<figure class:list={["aspect-21/9 overflow-hidden bg-muted", className]}>
  <Image class="h-full w-full object-cover" src={src} alt={alt} width={width} height={height} widths={widths} sizes={sizes} loading="lazy" />
</figure>
