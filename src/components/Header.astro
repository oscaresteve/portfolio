---
import { t } from "../i18n";

const { brand, nav, cv, cvLabel } = t.header;
const link = "-my-1 py-1 transition-colors duration-300 hover:text-primary";
---

<header class="mx-auto flex h-18 w-full max-w-7xl px-4 sm:px-10">
  <nav class="flex w-full flex-wrap items-center justify-end gap-x-4 text-nowrap text-xs sm:gap-x-10 sm:text-sm">
    <a
      class:list={["hidden sm:block mr-auto w-full font-display tracking-tight text-muted-foreground sm:w-auto", link]}
      href="/">{brand}</a
    >
    <a class={link} href="/#proyectos">{nav.projects}</a>
    <a class={link} href="/#experiencia">{nav.experience}</a>
    <a class={link} href="/#sobre-mi">{nav.about}</a>
    <a
      class="-my-1 py-1 text-primary transition-colors duration-300 hover:text-muted-foreground"
      href="/cv-oscar-esteve.pdf"
      aria-label={cvLabel}
      download
    >
      {cv}
    </a>
  </nav>
</header>
