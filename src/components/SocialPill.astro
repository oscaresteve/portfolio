---
const { class: className, href, ...rest } = Astro.props;

const isExternal = typeof href === "string" && href.startsWith("http");
---

<a
  class:list={[
    "-my-1 inline-flex items-center gap-x-2 py-1 text-xs text-muted-foreground transition-colors duration-300 hover:text-primary sm:text-sm",
    className,
  ]}
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener" : undefined}
  {...rest}
>
  <slot />
</a>
