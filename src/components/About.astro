---
import { Image } from "astro:assets";
import SectionTitle from "./SectionTitle.astro";
import TagList from "./TagList.astro";
import { STACK } from "../data/stack";
import { useTranslations } from "../i18n";
import oscaresteve from "../assets/foto-perfil-camisa.webp";

const { bio, educationTitle, education, stackTitle, stack, languages, photoAlt } = useTranslations(
  Astro.currentLocale,
).about;
---

<article class="grid grid-cols-1 items-start gap-10 md:grid-cols-12">
  <div class="flex flex-col gap-y-8 md:col-span-7">
    <div class="flex max-w-prose flex-col gap-y-4 text-muted-foreground">
      {bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="flex flex-col gap-y-4">
      <SectionTitle as="h3">{educationTitle}</SectionTitle>

      <ol class="flex flex-col gap-y-4">
        {
          education.map(({ title, place, date }) => (
            <li class="flex flex-col gap-y-1">
              <p class="text-foreground">{title}</p>
              <p class="font-mono text-xs italic tracking-widest text-muted-foreground">
                {place} · {date}
              </p>
            </li>
          ))
        }
      </ol>

      <p class="text-sm text-muted-foreground">{languages}</p>
    </div>
  </div>

  <div class="flex flex-col gap-y-8 md:col-span-5">
    <Image
      src={oscaresteve}
      alt={photoAlt}
      class="border border-muted h-auto w-full object-cover"
      widths={[480, 960]}
      sizes="(min-width: 768px) 477px, calc(100vw - 2rem)"
      loading="lazy"
    />

    <div class="flex flex-col gap-y-4">
      <SectionTitle as="h3">{stackTitle}</SectionTitle>

      <ul class="flex flex-col gap-y-4">
        {
          STACK.map(({ id, tags }) => (
            <li class="flex flex-col gap-y-1">
              <p class="font-mono text-xs italic tracking-widest text-muted-foreground">{stack[id]}</p>
              <TagList tags={tags} class="text-xs text-foreground sm:text-sm" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</article>
