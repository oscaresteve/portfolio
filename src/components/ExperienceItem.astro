---
interface Props {
  date: string;
  job: string;
  title: string;
  description: string;
}

const { date, job, title, description } = Astro.props;
---

<article class="flex flex-col gap-y-2">
  <p class="font-mono text-xs italic tracking-widest text-muted-foreground">{date}</p>

  <h3 class="font-display text-3xl text-foreground">
    {title}<span class="text-muted-foreground"> · {job}</span>
  </h3>

  <p class="max-w-prose text-sm text-muted-foreground">{description}</p>
</article>
