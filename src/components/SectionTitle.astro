---
interface Props {
  as?: "h2" | "h3";
  count?: number;
}

const { as: Heading = "h2", count } = Astro.props;
---

<Heading class="font-mono text-xs italic text-muted-foreground sm:text-sm">
  // <slot />{count !== undefined && <span class="tabular-nums"> ({String(count).padStart(2, "0")})</span>}
</Heading>
