---
import ExperienceItem from "./ExperienceItem.astro";
import { useTranslations } from "../i18n";

const { experience } = useTranslations(Astro.currentLocale);
---

<ol class="divide-y divide-muted">
  {
    experience.map((job) => (
      <li class="pt-8 pb-6">
        <ExperienceItem {...job} />
      </li>
    ))
  }
</ol>
