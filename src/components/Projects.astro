---
import ProjectShot from "./ProjectShot.astro";
import TagList from "./TagList.astro";
import { PROJECTS } from "../data/projects";
import { getLocale, projectUrl, useTranslations } from "../i18n";

const locale = getLocale(Astro.currentLocale);

const { items, goToProject } = useTranslations(locale).projects;
---

<ol class="divide-y divide-muted [--indent:2rem] sm:[--indent:3rem]">
  {
    PROJECTS.map(({ slug, image, tags }, position) => {
      const { title, summary, imageAlt } = items[slug];

      return (
        <li class="group text-muted-foreground">
          <div class="flex flex-col gap-y-3 pt-8 pb-6 sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-10">
            <h3 class="flex items-baseline font-display text-3xl leading-none sm:text-4xl lg:text-5xl">
              <span class="w-(--indent) shrink-0 font-mono text-xs italic tracking-widest tabular-nums" aria-hidden="true">
                {String(position + 1).padStart(2, "0")}
              </span>

              <a
                class="text-balance text-foreground transition-colors duration-300 group-hover:text-primary group-focus-within:text-primary focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4"
                href={projectUrl(locale, slug)}
              >
                {title}
              </a>
            </h3>

            <TagList tags={tags} class="pl-(--indent) text-xs sm:pl-0 sm:text-right sm:text-sm" />
          </div>

          <div class="grid gap-6 pb-10 pl-(--indent) md:grid-cols-12 md:gap-x-6 lg:gap-x-10">
            <ProjectShot src={image} alt={imageAlt} class="border border-muted md:col-span-7" />

            <div class="flex flex-col gap-y-4 text-sm md:col-span-5 md:self-end">
              <p class="max-w-prose">{summary}</p>

              <a
                class="-my-1 py-1 text-primary transition-colors duration-300 hover:text-muted-foreground focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-4"
                href={projectUrl(locale, slug)}
              >
                {goToProject}
              </a>
            </div>
          </div>
        </li>
      );
    })
  }
</ol>
